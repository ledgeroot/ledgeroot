# Ledgeroot environment — copy to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit it or share its contents.

# SQLite database path (defaults to ./ledgeroot.sqlite)
LEDGEROOT_DB=./ledgeroot.sqlite

# Signing wallet private key, used for payments. It also submits anchors unless
# LEDGEROOT_ANCHOR_KEY is set below.
# Keep it on this machine only. NEVER commit or paste into chat.
LEDGEROOT_PRIVATE_KEY=0x...

# Key that submits anchors. Falls back to LEDGEROOT_PRIVATE_KEY, which is the
# historical behaviour. Set it so an unattended `anchor --watch` loop never holds
# the key that moves money — the contract's owner must be this key, and
# LedgerootAnchor has no transferOwnership, so separating them means deploying
# the contract with it as owner.
# LEDGEROOT_ANCHOR_KEY=0x...

# Receipt signing key (32-byte hex seed). Attests to what happened, and is kept
# separate from the payment key, which authorizes funds. Without it receipts are
# recorded unsigned and verification reports them as incomplete.
LEDGEROOT_SIGNING_KEY=0x...

# Addresses whose mandate signatures may be imported (comma-separated). When
# unset, only the local signer (derived from LEDGEROOT_PRIVATE_KEY) is trusted.
# An import signed by anyone else is refused — without this a caller could mint
# its own permissive authorization and spend against it.
LEDGEROOT_TRUSTED_ISSUERS=

# Allow `ledgeroot_buy` to fetch private, loopback or link-local addresses.
# Leave unset in any real deployment: an agent steered toward an arbitrary URL
# must not be able to read this machine's services or a cloud metadata endpoint.
# LEDGEROOT_ALLOW_PRIVATE_HOSTS=true

# Monad testnet RPC URL (confirm against monad.xyz)
LEDGEROOT_RPC_URL=https://testnet-rpc.monad.xyz

# Monad mainnet RPC URL, used when verifying a receipt that settled on chain 143.
LEDGEROOT_MAINNET_RPC_URL=https://rpc.monad.xyz

# Chain the anchorer targets: 10143 (testnet, default) or 143 (mainnet). Mainnet
# anchoring also needs LEDGEROOT_ANCHOR_ADDRESS to name a contract on that chain.
# LEDGEROOT_CHAIN_ID=10143

# Monad x402 facilitator HTTP endpoint (public, no API key)
LEDGEROOT_FACILITATOR_URL=https://x402-facilitator.molandak.org

# Anchor contract address on the chain LEDGEROOT_CHAIN_ID selects (set after deploy)
LEDGEROOT_ANCHOR_ADDRESS=

# Anchor contract deployer key (used by deploy/monad.ts). The contract owner is
# derived from LEDGEROOT_PRIVATE_KEY above, since that is the wallet which calls
# anchor() — a deployer key distinct from it is expected.
LEDGEROOT_DEPLOYER_PRIVATE_KEY=0x...

# Anchor contract bytecode (used by deploy/monad.ts). Leave unset to deploy the
# artifact from `forge build`.
LEDGEROOT_ANCHOR_BYTECODE=0x...

# --- Real purchase demo (`npm run demo:buy`) -----------------------------------
# Buys the resource at BUY_URL over x402 and settles with real USDC, so the payer
# key above needs a balance on BUY_CHAIN. The seller settles the payment; the
# facilitator URL above is not used on this path.
# LEDGEROOT_BUY_URL=https://agent402.tools/api/hash
# LEDGEROOT_BUY_PAYTO=0xaBF4FAbd7c416fB67202E5f9002389Fc75e2a9D0
# LEDGEROOT_BUY_CHAIN=143
# LEDGEROOT_BUY_METHOD=POST
# LEDGEROOT_BUY_BODY={"text":"hello world","algo":"sha256"}
